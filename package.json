{
  "name": "@nickchristensen/cliftin",
  "description": "A read-only HTTP API for Liftin' workout data",
  "version": "5.0.0",
  "author": "Nick Christensen",
  "bugs": "https://github.com/nickchristensen/cliftin/issues",
  "dependencies": {
    "@fastify/swagger": "^9.8.0",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.41",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "fastify": "^5.10.0",
    "kysely": "^0.28.11"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@eslint/js": "^9",
    "@redocly/cli": "^2.38.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "mocha": "^11.7.5",
    "shx": "^0.3.3",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "^10",
    "typescript-eslint": "^8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": ["./dist", "./openapi.json"],
  "homepage": "https://github.com/nickchristensen/cliftin",
  "keywords": ["api", "fastify", "liftin", "sqlite"],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "repository": "nickchristensen/cliftin",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "openapi:generate": "npm run build && node dist/openapi.js",
    "openapi:validate": "npm run openapi:generate && redocly lint openapi.json",
    "posttest": "npm run lint",
    "prepare": "simple-git-hooks",
    "start": "node dist/server.js",
    "test": "mocha --forbid-only \"test/**/*.test.ts\""
  },
  "simple-git-hooks": {
    "pre-commit": "npm run build && git add openapi.json",
    "pre-push": "npm run build && npm test"
  },
  "types": "dist/index.d.ts"
}
